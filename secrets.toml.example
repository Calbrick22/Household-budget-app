# Copy this file to .streamlit/secrets.toml and fill in your real database
# details. secrets.toml itself is gitignored - never commit real credentials.
#
# For Streamlit Community Cloud, you don't edit a file - you paste this same
# content into the app's "Edit Secrets" screen in the dashboard instead.

app_password = "choose-a-shared-password"

[connections.postgresql]
dialect = "postgresql"
host = "your-database-host"
port = "5432"
database = "your-database-name"
username = "your-username"
password = "your-database-password"
