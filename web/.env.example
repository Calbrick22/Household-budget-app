# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables instead. Never commit real values.

# The Neon connection string (Dashboard -> Connection details, "Pooled connection").
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The shared password you both use to unlock the app.
APP_PASSWORD="choose-a-shared-password"

# Any long random string; signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="replace-with-at-least-32-random-characters"
